# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Auth
JWT_SECRET=super-secret-jwt-key-2026-royal-carnival

# CORS Allowed Origin (Optional - defaults to * for easy development)
# CLIENT_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL & Redis Configuration (Optional)
# If omitted or unavailable, the backend automatically uses SQLite WAL (local database in backend/data/app.db) and in-memory cache!
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_reservation_db
# REDIS_URL=redis://localhost:6379
