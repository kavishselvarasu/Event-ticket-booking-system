          "name": "5.1 Edge Case: Insufficient Inventory (Sold Out Attempt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Error is INSUFFICIENT_INVENTORY', function () { pm.expect(jsonData.error).to.eql('INSUFFICIENT_INVENTORY'); });"
