  "item": [
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "1.1 Organizer Login (Apex Tech)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Token received', function () { pm.expect(jsonData.token).to.not.be.empty; });",
                  "pm.test('Role is organizer', function () { pm.expect(jsonData.user.role).to.eql('organizer'); });",
                  "pm.collectionVariables.set('authToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@apextech.io\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
