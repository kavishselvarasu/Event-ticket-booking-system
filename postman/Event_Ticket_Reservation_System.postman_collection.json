    {
      "name": "3. 10-Minute Temporary Reservation Engine",
      "item": [
        {
          "name": "3.1 Create 10-Minute Temporary Hold (Atomic Lock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Hold is HELD', function () { pm.expect(jsonData.data.status).to.eql('HELD'); });",
                  "pm.test('Remaining seconds is 600', function () { pm.expect(jsonData.data.remainingSeconds).to.be.at.most(600); });",
                  "pm.collectionVariables.set('activeHoldId', jsonData.data.holdId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-ID",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"ticketTierId\": \"{{tierId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "hold"]
            }
          }
        },
        {
          "name": "3.2 Check Live Hold Countdown Timer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Remaining countdown is active', function () { pm.expect(jsonData.data.remainingSeconds).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/hold/{{activeHoldId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "hold", "{{activeHoldId}}"]
            }
          }
        }
      ]
