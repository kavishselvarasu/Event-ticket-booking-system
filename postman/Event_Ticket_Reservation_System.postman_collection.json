        {
          "name": "5.3 High-Concurrency Stress Test (25 Parallel Requests / 5 Seats)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Double booked seats is 0', function () { pm.expect(jsonData.testSummary.doubleBookedSeats).to.eql(0); });",
                  "pm.test('Race condition prevented is true', function () { pm.expect(jsonData.testSummary.raceConditionPrevented).to.be.true; });",
                  "pm.test('Successful holds equals configured seats', function () { pm.expect(jsonData.testSummary.successfulHolds).to.eql(5); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalSeats\": 5,\n  \"concurrentRequests\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/test/concurrency",
              "host": ["{{baseUrl}}"],
              "path": ["api", "test", "concurrency"]
            }
          }
        }
